#!/bin/sh
# Prints a secret for mise's [env] (see mise.toml), never failing:
#
#   cached-secret <cache-name> <command...>
#
# Runs <command> (normally `vault kv get ...`) at most once per CACHE_TTL and
# keeps the last good value in ~/.cache/simic-systems/ (mode 600). If the
# command fails (Vault login expired, offline), the last cached value is used
# with a warning, so an expired token degrades to a warning instead of every
# mise command in the repo erroring. In CI it prints nothing.
#
# Only test-mode / public values go through here: the live Stripe key is
# fetched by the tasks that need it, at run time, and never cached.
set -u
[ -n "${CI:-}" ] && exit 0

name=$1
shift
CACHE_TTL=${SIMIC_SECRET_CACHE_TTL:-43200} # 12h
dir="${XDG_CACHE_HOME:-$HOME/.cache}/simic-systems"
file="$dir/$name"

age() { echo $(($(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0))); }

if [ -s "$file" ] && [ "$(age "$file")" -lt "$CACHE_TTL" ]; then
  cat "$file"
  exit 0
fi

if value=$("$@" 2>/dev/null) && [ -n "$value" ]; then
  umask 077
  mkdir -p "$dir"
  printf '%s' "$value" >"$file.tmp" && mv "$file.tmp" "$file"
  printf '%s' "$value"
elif [ -s "$file" ]; then
  echo "simic: couldn't refresh $name from Vault, using the cached value (vault login -method=oidc role=admin)" >&2
  cat "$file"
else
  echo "simic: $name unavailable: run vault login -method=oidc role=admin, then mise cache clear" >&2
fi
exit 0
