---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
import Stripe from "stripe";
import { env } from "cloudflare:workers";
import { isCheckoutSessionId } from "../../lib/checkoutSessions";
import { orderNumberFor } from "../../lib/email/fromCheckoutSession";

export const prerender = false;

// Only ever a real Checkout session id: the value is echoed into an inline
// script below, so anything else is dropped rather than escaped and trusted.
const rawSessionId = Astro.url.searchParams.get("session_id");
const sessionId = isCheckoutSessionId(rawSessionId) ? rawSessionId : null;

let session: Stripe.Checkout.Session | null = null;
let lineItems: Stripe.LineItem[] = [];

if (sessionId) {
  try {
    const stripe = new Stripe(env.STRIPE_SECRET_KEY, {
      httpClient: Stripe.createFetchHttpClient(),
    });

    session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ["line_items.data.price"],
    });
    lineItems = session.line_items?.data || [];
  } catch (err) {
    console.error("Failed to retrieve checkout session:", err);
  }
}

// "paid" is the normal card case; a completed-but-unpaid session is a delayed
// payment method (e.g. bank debit) that hasn't cleared yet.
const paid = session?.status === "complete" && session.payment_status !== "unpaid";
const processing = session?.status === "complete" && session.payment_status === "unpaid";
const orderNumber = session && (paid || processing) ? orderNumberFor(session) : null;
const email = session?.customer_details?.email;
// Newer API versions moved shipping details under collected_information.
const shipping =
  session?.collected_information?.shipping_details ??
  (session as unknown as { shipping_details?: Stripe.Checkout.Session.CollectedInformation.ShippingDetails } | null)
    ?.shipping_details;

// The page shows order details to whoever holds the URL: keep it out of
// shared/browser caches.
Astro.response.headers.set("Cache-Control", "no-store");

const nonce = Astro.locals.nonce;

// JSON.stringify doesn't escape "<", so a value containing "</script>" could
// close the tag early; \u003c keeps the inline script inert either way.
const toScript = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

// Vars are inlined via a template literal instead of define:vars — the Astro
// compiler silently drops any other dynamic attribute (including nonce={...})
// from a <script> tag that also uses define:vars.
const orderConfirmedScript = paid
  ? `(function(){
localStorage.removeItem("simic-cart");
localStorage.removeItem("simic-checkout-session");
window.posthog?.capture('order_confirmed', {
  stripe_session_id: ${toScript(sessionId)},
  amount_total_cents: ${toScript(session?.amount_total ?? null)},
  item_count: ${toScript(lineItems.reduce((s, i) => s + (i.quantity ?? 0), 0))},
});
})();`
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Order Confirmed - ${SITE_TITLE}`} description="Thank you for your purchase" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      main {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
      }
      .order-header {
        text-align: center;
        margin-bottom: 2rem;
      }
      .order-header h1 {
        font-size: 1.8em;
        margin-bottom: 0.5rem;
      }
      .order-section {
        background: var(--bg-secondary);
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
      }
      .order-section h2 {
        font-size: 1.1em;
        margin-bottom: 0.75rem;
      }
      .line-item {
        display: flex;
        justify-content: space-between;
        padding: 0.4rem 0;
      }
      .line-item + .line-item {
        border-top: 1px solid rgb(var(--gray-light));
      }
      .order-total {
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        font-size: 1.1em;
        padding-top: 0.75rem;
        border-top: 2px solid rgb(var(--gray-light));
        margin-top: 0.5rem;
      }
      .back-link {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--color-primary-fixed-dim);
        color: var(--color-on-primary-fixed);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 4px;
        text-align: center;
      }
      .back-link:hover {
        background: var(--color-primary-fixed);
        color: var(--color-on-primary-fixed);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="order-header">
        {paid && (
          <>
            <h1>Thank you for your order!</h1>
            <p>Order <strong>{orderNumber}</strong></p>
            {email && <p>A confirmation has been sent to <strong>{email}</strong>.</p>}
          </>
        )}
        {processing && (
          <>
            <h1>Your payment is processing</h1>
            <p>Order <strong>{orderNumber}</strong></p>
            <p>We'll email {email ? <strong>{email}</strong> : "you"} as soon as your payment clears. Your order ships after that.</p>
          </>
        )}
        {!paid && !processing && (
          <>
            <h1>We couldn't find that order</h1>
            <p>
              If you just paid, check your email for a receipt from Stripe and an order confirmation from us.
              Questions? <a href="/contact/">Contact us</a>.
            </p>
          </>
        )}
      </div>

      {(paid || processing) && lineItems.length > 0 && (
        <div class="order-section">
          <h2>Items Ordered</h2>
          {lineItems.map((item) => (
            <div class="line-item">
              <span>{item.description} &times; {item.quantity}</span>
              <span>${((item.amount_total || 0) / 100).toFixed(2)}</span>
            </div>
          ))}
        </div>
      )}

      {(paid || processing) && session && (
        <div class="order-section">
          {session.shipping_cost && session.shipping_cost.amount_total > 0 && (
            <div class="line-item">
              <span>Shipping</span>
              <span>${(session.shipping_cost.amount_total / 100).toFixed(2)}</span>
            </div>
          )}
          {session.total_details?.amount_tax != null && session.total_details.amount_tax > 0 && (
            <div class="line-item">
              <span>Tax</span>
              <span>${(session.total_details.amount_tax / 100).toFixed(2)}</span>
            </div>
          )}
          <div class="order-total">
            <span>Total</span>
            <span>${((session.amount_total || 0) / 100).toFixed(2)}</span>
          </div>
        </div>
      )}

      {(paid || processing) && shipping?.address && (
        <div class="order-section">
          <h2>Shipping To</h2>
          <p style="margin: 0; line-height: 1.6;">
            {shipping.name && <>{shipping.name}<br /></>}
            {shipping.address.line1}<br />
            {shipping.address.line2 && <>{shipping.address.line2}<br /></>}
            {shipping.address.city}, {shipping.address.state} {shipping.address.postal_code}
          </p>
        </div>
      )}

      <div style="text-align: center;">
        <a href="/" class="back-link">Back to Store</a>
      </div>
    </main>
    <Footer />
    {orderConfirmedScript && <script is:inline nonce={nonce} set:html={orderConfirmedScript} />}
  </body>
</html>
