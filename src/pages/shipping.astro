---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { SIGNATURE_THRESHOLD_CENTS, STANDARD_SHIPPING_CENTS, SIGNATURE_SHIPPING_CENTS } from '../lib/shipping';

const nonce = Astro.locals.nonce;
const dollars = (cents: number) => `$${cents / 100}`;
const standardRate = dollars(STANDARD_SHIPPING_CENTS);
const signatureRate = dollars(SIGNATURE_SHIPPING_CENTS);
const signatureThreshold = dollars(SIGNATURE_THRESHOLD_CENTS);

const shippingSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": "Shipping Policy",
	"url": "https://simic.systems/shipping/",
	"description": "Shipping policy for Simic Systems. US shipping only. Flat $8 shipping under $250; $15 with Signature Confirmation for $250 or more. All sales final.",
	"mainEntity": {
		"@type": "MerchantReturnPolicy",
		"name": "Simic Systems Return Policy",
		"returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
		"applicableCountry": "US",
		"description": "All sales are final. We do not accept returns except in the case of damaged or incorrect orders."
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Shipping Policy — USPS Ground Advantage | ${SITE_TITLE}`} description="Simic Systems ships factory-sealed Magic: The Gathering products via USPS Ground Advantage within the US. Orders processed in 1–3 business days. All sales are final." />
		<script type="application/ld+json" nonce={nonce} set:html={JSON.stringify(shippingSchema)}></script>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1>Shipping Policy</h1>

				<h2>Shipping</h2>
				<p>
					We currently ship to addresses within the <strong>United States</strong> only. Orders are shipped via <strong>USPS Ground Advantage</strong>.
				</p>
				<ul>
					<li>Orders are typically processed and shipped within 1–3 business days.</li>
					<li>You will receive a shipping confirmation email with tracking information once your order has shipped.</li>
					<li>Delivery times vary by location but generally take 3–7 business days after shipment.</li>
					<li>Every order is insured for its full value.</li>
					<li>Sales tax, where applicable, is calculated at checkout.</li>
				</ul>

				<h2>Shipping Rates</h2>
				<table class="rates">
					<thead>
						<tr><th scope="col">Order subtotal</th><th scope="col">Shipping</th><th scope="col">Service</th></tr>
					</thead>
					<tbody>
						<tr><td>Under {signatureThreshold}</td><td>{standardRate}</td><td>USPS Ground Advantage</td></tr>
						<tr><td>{signatureThreshold} or more</td><td>{signatureRate}</td><td>USPS Ground Advantage with Signature Confirmation</td></tr>
					</tbody>
				</table>
				<p>
					Shipping is a flat rate per order, not per item. Orders of {signatureThreshold} or more require a signature upon delivery, since sealed product at that value is worth protecting.
				</p>

				<h2>Return Policy</h2>
				<p>
					<strong>All sales are final.</strong> Due to the nature of factory-sealed trading card products, we do not accept returns.
				</p>

				<h2>Damaged or Incorrect Orders</h2>
				<p>
					If your order arrives damaged or you receive the wrong item, please contact us within 7 days of delivery at <a href="mailto:contact@simic.systems">contact@simic.systems</a>. Include photos of the issue and your order number, and we'll make it right.
				</p>

				<p>
					Questions about shipping? <a href="/contact/">Contact us</a>.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
	}
	article h1 {
		margin-bottom: 1rem;
	}
	article h2 {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}
	ul {
		margin-bottom: 1.5em;
	}
	li {
		margin-bottom: 0.5em;
	}
	.rates {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1rem;
	}
	.rates th,
	.rates td {
		text-align: left;
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid rgba(var(--gray-light), 0.6);
	}
</style>
