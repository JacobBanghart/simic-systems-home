---
// Rendered per request (not prerendered) so the middleware's security
// headers and a real per-request script nonce apply, like every other page.
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Terms of Service - ${SITE_TITLE}`} description="Terms of service for Simic Systems. Covers products, orders, payment via Stripe, shipping, returns, and liability." />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1>Terms of Service</h1>
				<p><em>Last updated: October 6, 2026</em></p>

				<p>
					By using the Simic Systems website at simic.systems and making purchases, you agree to the following terms.
				</p>

				<h2>Products</h2>
				<p>
					All products sold through our store are factory-sealed trading card products. Product images and descriptions are provided for reference. Actual packaging may vary slightly from what is shown.
				</p>
				<p>
					Product availability and pricing are subject to change without notice. We reserve the right to limit quantities, refuse orders, or cancel orders at our discretion.
				</p>

				<h2>Orders and Payment</h2>
				<p>
					All payments are processed securely through Stripe. By placing an order, you confirm that the payment information you provide is accurate and that you are authorized to use the payment method.
				</p>
				<p>
					Prices are listed in US dollars. Sales tax, where applicable, is calculated at checkout by Stripe.
				</p>

				<h2>Shipping</h2>
				<p>
					We ship to addresses within the United States only, via USPS Ground Advantage, and typically process orders within 1–3 business days. Shipping is a flat $8 for orders under $250 and $15 for orders of $250 or more; orders of $250 or more are shipped with Signature Confirmation, and a signature is required on delivery. Every order is insured for its full value. See our <a href="/shipping/">Shipping & Returns</a> page for full details on shipping timelines and return procedures.
				</p>

				<h2>Returns and Refunds</h2>
				<p>
					All sales are final. We do not accept returns on factory-sealed products. If your order arrives damaged or incorrect, please see our <a href="/shipping/">Shipping & Returns</a> page for how to contact us.
				</p>

				<h2>Limitation of Liability</h2>
				<p>
					Simic Systems is not responsible for delays caused by shipping carriers, customs, or circumstances beyond our control. Our liability is limited to the purchase price of the products ordered.
				</p>

				<h2>Changes to These Terms</h2>
				<p>
					We may update these terms from time to time. Changes will be posted on this page with an updated "last updated" date. Continued use of the site after changes constitutes acceptance of the new terms.
				</p>

				<h2>Contact</h2>
				<p>
					Questions about these terms? Contact us at <a href="mailto:contact@simic.systems">contact@simic.systems</a>.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
	}
	article h1 {
		margin-bottom: 1rem;
	}
	article h2 {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}
</style>
