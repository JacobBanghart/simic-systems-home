# Copy to .env — loaded by Vite/Astro at build time (import.meta.env.*) to
# inline the PUBLIC_ vars, and by `wrangler dev` as local vars when no
# .dev.vars exists (the build copies it into dist/server/.dev.vars).
#
# The LIVE Stripe key deliberately is NOT named STRIPE_SECRET_KEY, so local
# builds/previews never run against live Stripe. It's read by
# `mise run tf:stripe` and scripts/resend-failed-webhooks.mjs.
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
