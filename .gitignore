# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables (examples stay tracked)
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler files
.wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example

# internal docs
docs/
seo-plan.md

# terraform (any stack under terraform/; .terraform.lock.hcl stays tracked)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
!**/*.tfvars.example
terraform/**/backend.conf
